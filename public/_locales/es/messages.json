    "help_wildcard_title": {
        "message": "Patrones Simples"
    },
    "help_wildcard_desc": {
        "message": "Usa '*' para coincidir con cualquier texto. Cada valor '*' está disponible como $1, $2, etc., en el destino."
    },
    "help_pattern_title": {
        "message": "Parámetros con Nombre"
    },
    "help_pattern_desc": {
        "message": "Captura partes específicas de la URL usando ':nombre'. Usa {{nombre}} en el destino para insertarlas."
    },
