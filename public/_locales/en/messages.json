    "app_buy_coffee": {
        "message": "Buy me a coffee"
    },
    "help_decode_title": {
        "message": "Decoding Parameters"
    },
    "help_decode_desc": {
        "message": "When enabled, captured values (like $1 or {{name}}) will be decoded (URI unescaped) before being inserted into the destination."
    },
    "help_decode_example_desc": {
        "message": "For example, if the URL contains '%3A%2F%2F', decoding will convert it to '://'."
    },
    "help_groups_title": {
        "message": "Rule Groups"
    },
    "help_groups_desc": {
        "message": "Groups allow you to organize your rules. Disabling a group will disable all rules within it."
    },
    "help_tips_title": {
        "message": "General Tips"
    },
    "help_tips_order": {
        "message": "Order matters: Rules are processed from top to bottom. The first rule that matches will be applied."
    },
    "help_tips_testing": {
        "message": "Test your rules: Use the 'Test URL' field in the rule editor to verify your patterns before saving."
    }
