    "help_title": {
        "message": "Redirector Help"
    },
    "help_desc": {
        "message": "Learn how to create powerful redirection rules using different matching modes."
    },
    "help_static_title": {
        "message": "Exact Match"
    },
    "help_static_desc": {
        "message": "The simplest mode. It matches the source URL exactly as written."
    },
    "help_wildcard_title": {
        "message": "Simple Patterns"
    },
    "help_wildcard_desc": {
        "message": "Use '*' to match any text. Each '*' value is available as $1, $2, etc., in the destination."
    },
    "help_pattern_title": {
        "message": "Named Parameters"
    },
    "help_pattern_desc": {
        "message": "Capture specific parts of the URL using ':name'. Use {{name}} in the destination to insert them."
    },
    "help_regex_title": {
        "message": "Regular Expressions"
    },
    "help_regex_desc": {
        "message": "Full power of JavaScript Regular Expressions. Use capture groups () and $1, $2 to reference them."
    },
    "help_example_result": {
        "message": "Example result"
    },
    "help_input_rule": {
        "message": "Input (Source URL)"
    },
    "help_destination_rule": {
        "message": "Redirect to (Destination)"
    },
